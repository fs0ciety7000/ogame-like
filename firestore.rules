rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profil joueur : lisible par tout joueur connecté (classement, espionnage),
    // modifiable uniquement par son propriétaire. Le jeu est côté client
    // (comme le prototype d'origine) : pas de Cloud Functions nécessaires,
    // ce qui garde le déploiement gratuit sur le plan Spark de Firebase.
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      // Files d'attente (constructions, recherches, missions) : privées.
      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Journal d'évènements du joueur : privé.
      match /notifications/{notifId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Réservation pseudo -> email, utilisée pour résoudre la connexion par
    // pseudo et le mot de passe oublié (Firebase Auth ne connaît que des
    // emails). Lecture par id seul (jamais de liste, donc pas d'annuaire
    // consultable en masse) ; écriture réservée au propriétaire, et un
    // pseudo déjà pris par quelqu'un d'autre ne peut pas être écrasé.
    match /usernames/{pseudo} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/usernames/$(pseudo))
            || resource.data.uid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Rapports de combat : l'attaquant peut créer un rapport le concernant ;
    // les deux belligérants peuvent le lire ; seul le défenseur peut le
    // marquer comme traité (et rien d'autre) une fois consulté.
    match /battle_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.attackerUid == request.auth.uid
        && request.resource.data.defenderProcessed == false;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.attackerUid || request.auth.uid == resource.data.defenderUid);

      allow update: if signedIn()
        && request.auth.uid == resource.data.defenderUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defenderProcessed']);

      allow delete: if false;
    }

    // Rapports d'espionnage : uniquement créés quand la tentative est
    // détectée (voir rollSpyDetection côté client) — l'espion peut créer
    // un rapport le concernant ; les deux parties peuvent le lire ; seule
    // la cible peut le marquer comme traité une fois la notif générée.
    match /spy_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.spyUid == request.auth.uid
        && request.resource.data.targetProcessed == false;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.spyUid || request.auth.uid == resource.data.targetUid);

      allow update: if signedIn()
        && request.auth.uid == resource.data.targetUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['targetProcessed']);

      allow delete: if false;
    }

    // Dons de ressources entre joueurs : l'expéditeur crée le don (déjà
    // débité dans la même transaction côté client) ; les deux parties
    // peuvent le lire ; seul le destinataire peut le marquer comme
    // réclamé (et rien d'autre) en créditant ses propres ressources.
    match /resource_gifts/{giftId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.claimed == false;

      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);

      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);

      allow delete: if false;
    }
  }
}
